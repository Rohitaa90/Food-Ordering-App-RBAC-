      ]
    },
    {
      "name": "Restaurants",
      "item": [
        {
          "name": "Get All Restaurants",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/restaurants", "host": ["{{baseUrl}}"], "path": ["restaurants"] }
          }
        },
        {
          "name": "Get Restaurant by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/restaurants/:id", "host": ["{{baseUrl}}"], "path": ["restaurants", ":id"], "variable": [{ "key": "id", "value": "PASTE_RESTAURANT_ID_HERE" }] }
          }
        },
        {
          "name": "Get Restaurant Menu",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/restaurants/:id/menu", "host": ["{{baseUrl}}"], "path": ["restaurants", ":id", "menu"], "variable": [{ "key": "id", "value": "PASTE_RESTAURANT_ID_HERE" }] }
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"restaurantId\": \"PASTE_RESTAURANT_ID_HERE\",\n  \"items\": [\n    {\n      \"menuItemId\": \"PASTE_MENU_ITEM_ID_HERE\",\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/orders", "host": ["{{baseUrl}}"], "path": ["orders"] }
          }
        },
        {
          "name": "Get All Orders",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/orders", "host": ["{{baseUrl}}"], "path": ["orders"] }
          }
        },
        {
          "name": "Get Order by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/orders/:id", "host": ["{{baseUrl}}"], "path": ["orders", ":id"], "variable": [{ "key": "id", "value": "PASTE_ORDER_ID_HERE" }] }
          }
        },
        {
          "name": "Checkout Order (ADMIN/MANAGER only)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/orders/:id/checkout", "host": ["{{baseUrl}}"], "path": ["orders", ":id", "checkout"], "variable": [{ "key": "id", "value": "PASTE_ORDER_ID_HERE" }] }
          }
        },
        {
          "name": "Cancel Order (ADMIN/MANAGER only)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/orders/:id/cancel", "host": ["{{baseUrl}}"], "path": ["orders", ":id", "cancel"], "variable": [{ "key": "id", "value": "PASTE_ORDER_ID_HERE" }] }
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Get Payment Methods",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/payment-method", "host": ["{{baseUrl}}"], "path": ["payment-method"] }
          }
        },
        {
          "name": "Update Payment Method (ADMIN only)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"DEBIT_CARD\",\n  \"details\": \"{\\\"last4\\\": \\\"5678\\\", \\\"brand\\\": \\\"Visa\\\", \\\"expiry\\\": \\\"03/29\\\"}\",\n  \"isDefault\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/payment-method/:id", "host": ["{{baseUrl}}"], "path": ["payment-method", ":id"], "variable": [{ "key": "id", "value": "PASTE_PAYMENT_METHOD_ID_HERE" }] }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] }
          }
        }
      ]
    }
  ]
}
